# Variables requeridas para correr la API.
# Copiá este archivo a .env y completá los valores.
# En producción (Railway/Render) estas variables se configuran en el dashboard
# del hosting — nunca subas un .env con valores reales al repositorio.

# Puerto donde escucha el servidor (el hosting lo sobreescribe automáticamente)
PORT=3000

# API key de Anthropic — obtenela en https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Connection string de MongoDB.
# Desarrollo: instancia local (mongodb://127.0.0.1:27017/nombre-db).
# Producción (Paso 7, Atlas): connection string con usuario/password que
# provee Atlas — se carga como variable de entorno en Railway/Render,
# nunca se escribe en este repo.
MONGODB_URI=mongodb://127.0.0.1:27017/distribuidora
